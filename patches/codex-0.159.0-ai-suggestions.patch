+//! AI ghost text belongs to one draft revision and is never part of submitted input.
+
+use super::*;
+use crate::prompt_suggestion::SuggestionEvent;
+use crate::prompt_suggestion::SuggestionRequest;
+use std::sync::Arc;
+use tokio::sync::Mutex;
+use tokio_util::sync::CancellationToken;
+use uuid::Uuid;
+
+/// Owns one cancellable revision and the per-editor request cooldown; dropping it cancels work.
+pub(super) struct SuggestionState {
+    enabled: bool,
+    terminal_focused: bool,
+    request: Option<SuggestionRequest>,
+    suffix: Option<String>,
+    last_prefix: Option<String>,
+    pending: bool,
+    next_request: Arc<Mutex<tokio::time::Instant>>,
+}
+
+impl Default for SuggestionState {
+    fn default() -> Self {
+        Self {
+            enabled: std::env::var("AISWITCHER_CODEX_AI_SUGGESTIONS").is_ok_and(|v| v == "1"),
+            terminal_focused: true,
+            request: None,
+            suffix: None,
+            last_prefix: None,
+            pending: false,
+            next_request: Arc::new(Mutex::new(tokio::time::Instant::now())),
+        }
+    }
+}
+
+impl SuggestionState {
+    /// Cancels the timer or hidden model turn and removes its visual suggestion.
+    pub(super) fn cancel(&mut self) {
+        if let Some(request) = self.request.take() {
+            request.cancellation.cancel();
+        }
+        self.suffix = None;
+        self.pending = false;
+    }
+}
+
+impl Drop for SuggestionState {
+    fn drop(&mut self) {
+        self.cancel();
+    }
+}
+
+impl ChatComposer {
+    /// Suspends automatic completions while the terminal window is unfocused.
+    pub(crate) fn set_prompt_suggestion_focus(&mut self, focused: bool) {
+        self.suggestion.terminal_focused = focused;
+        if !focused {
+            self.sync_prompt_suggestion(false);
+        }
+    }
+
+    /// Enables completion only for an idle, plain-text draft with its cursor at the end.
+    fn suggestion_eligible(&self) -> bool {
+        let text = self.draft.textarea.text();
+        self.suggestion.enabled
+            && self.suggestion.terminal_focused
+            && self.has_focus
+            && self.draft.input_enabled
+            && !self.is_task_running
+            && !self.queue_submissions
+            && self.draft.textarea.mouse_selection_range().is_none()
+            && !self.blocks_direct_input
+            && !self.draft.is_bash_mode
+            && !self.draft.textarea.is_vim_enabled()
+            && self.config.popups_enabled
+            && !self.popup_active()
+            && self.attachments.is_empty()
+            && self.voice_strip.is_none()
+            && self.draft.pending_pastes.is_empty()
+            && !self.is_in_paste_burst()
+            && self.draft.textarea.text_elements().is_empty()
+            && self.draft.textarea.cursor() == text.len()
+            && text.len() <= 1024
+            && text.trim().chars().count() >= 3
+            && !text.contains('\n')
+            && !text.trim_start().starts_with(['/', '!', '@', '$'])
+    }
+
+    /// Debounces draft revisions for 1.2 seconds, with at most one dispatch per six seconds.
+    /// Ineligible input cancels outstanding work. No text is persisted or submitted here.
+    pub(crate) fn sync_prompt_suggestion(&mut self, available: bool) {
+        if !available || !self.suggestion_eligible() {
+            self.suggestion.cancel();
+            self.suggestion.last_prefix = None;
+            return;
+        }
+        let prefix = self.draft.textarea.text();
+        if self.suggestion.last_prefix.as_deref() == Some(prefix) {
+            return;
+        }
+        self.suggestion.cancel();
+        self.suggestion.last_prefix = Some(prefix.to_owned());
+        let Ok(runtime) = tokio::runtime::Handle::try_current() else {
+            return;
+        };
+        let request = SuggestionRequest {
+            id: Uuid::new_v4(),
+            prefix: prefix.to_owned(),
+            cancellation: CancellationToken::new(),
+        };
+        self.suggestion.request = Some(request.clone());
+        self.suggestion.pending = true;
+        let sender = self.app_event_tx.clone();
+        let next_request = self.suggestion.next_request.clone();
+        runtime.spawn(async move {
+            tokio::select! {
+                biased;
+                _ = request.cancellation.cancelled() => return,
+                _ = tokio::time::sleep(Duration::from_millis(1200)) => {}
+            }
+            let next = *next_request.lock().await;
+            tokio::select! {
+                biased;
+                _ = request.cancellation.cancelled() => return,
+                _ = tokio::time::sleep_until(next) => {}
+            }
+            *next_request.lock().await = tokio::time::Instant::now() + Duration::from_secs(6);
+            sender.send(AppEvent::PromptSuggestion(SuggestionEvent::Request(
+                request,
+            )));
+        });
+    }
+
+    /// Rejects responses for replaced drafts, cancelled requests and inactive input modes.
+    pub(crate) fn prompt_suggestion_is_current(&self, request: &SuggestionRequest) -> bool {
+        !request.cancellation.is_cancelled()
+            && self.suggestion_eligible()
+            && self
+                .suggestion
+                .request
+                .as_ref()
+                .is_some_and(|current| current.id == request.id)
+            && self.draft.textarea.text() == request.prefix
+    }
+
+    /// Applies validated ghost text to the matching revision without editing the draft.
+    pub(crate) fn apply_prompt_suggestion(
+        &mut self,
+        request: &SuggestionRequest,
+        suffix: Option<String>,
+    ) {
+        if self.prompt_suggestion_is_current(request) {
+            self.suggestion.pending = false;
+            self.suggestion.suffix = suffix;
+        }
+    }
+
+    /// Gives Esc to the suggestion only while it owns a current loading/preview state.
+    pub(crate) fn suggestion_owns_escape(&self) -> bool {
+        self.suggestion
+            .request
+            .as_ref()
+            .is_some_and(|request| self.prompt_suggestion_is_current(request))
+            && (self.suggestion.pending || self.suggestion.suffix.is_some())
+    }
+
+    /// Tab inserts preview text through the normal undo-aware editor; Esc only dismisses it.
+    /// Popup, Vim, running-task queue and modified-key bindings keep their existing behavior.
+    pub(super) fn handle_suggestion_key(&mut self, key: KeyEvent) -> bool {
+        if key.modifiers != KeyModifiers::NONE || !self.suggestion_owns_escape() {
+            return false;
+        }
+        if key.code == KeyCode::Esc {
+            self.suggestion.cancel();
+            return true;
+        }
+        if key.code == KeyCode::Tab
+            && let Some(suffix) = self.suggestion.suffix.take()
+        {
+            self.suggestion.cancel();
+            self.insert_str(&suffix);
+            self.suggestion.last_prefix = Some(self.draft.textarea.text().to_owned());
+            return true;
+        }
+        false
+    }
+
+    /// Paints only a clipped preview after the real cursor plus a compact hint in existing padding.
+    /// Neither measurement nor cursor position includes ghost text, even at narrow widths.
+    pub(super) fn render_prompt_suggestion(&self, area: Rect, input: Rect, buf: &mut Buffer) {
+        if !self.suggestion_owns_escape() {
+            return;
+        }
+        let style = appearance::composer_appearance().placeholder.italic();
+        if let Some(suffix) = &self.suggestion.suffix {
+            let state = *self.draft.textarea_state.borrow();
+            if let Some((x, y)) = self.draft.textarea.cursor_pos_with_state(input, state) {
+                buf.set_stringn(
+                    x,
+                    y,
+                    suffix,
+                    usize::from(input.right().saturating_sub(x)),
+                    style,
+                );
+            }
+        }
+        let hint = if self.suggestion.pending {
+            "AI…"
+        } else {
+            "Tab accept · Esc dismiss"
+        };
+        let hint_width = unicode_width::UnicodeWidthStr::width(hint) as u16;
+        if area.height >= 3 && area.width >= hint_width + 4 {
+            buf.set_string(
+                area.right() - hint_width - 2,
+                area.bottom() - 1,
+                hint,
+                appearance::composer_appearance().placeholder,
+            );
+        }
+    }
+}
+
+#[cfg(test)]
+#[path = "suggestions_tests.rs"]
