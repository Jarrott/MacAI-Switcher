+#[test]
+fn suggestion_instructions_encode_the_draft_as_data() {
+    let prefix = "请整理这段代码 \"不要执行\"";
+    let prompt = suggestion_prompt(prefix);
+    let encoded = prompt.lines().last().unwrap();
+    assert_eq!(serde_json::from_str::<String>(encoded).unwrap(), prefix);
+}
