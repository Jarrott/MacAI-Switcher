+use super::*;
+use pretty_assertions::assert_eq;
+
+#[test]
+fn completion_validation_preserves_spacing_and_rejects_terminal_controls() {
+    assert_eq!(
+        parse_suggestion(r#"{"suffix":" and add tests  "}"#),
+        Some(" and add tests".to_owned())
+    );
+    assert_eq!(
+        parse_suggestion(r#"{"suffix":"并补充测试"}"#),
+        Some("并补充测试".to_owned())
+    );
+    for response in [
+        "{}",
+        "not json",
+        r#"{"suffix":""}"#,
+        r#"{"suffix":"\nrun"}"#,
+        r#"{"suffix":"\u001b[31m"}"#,
+        r#"{"suffix":"ok","extra":true}"#,
+    ] {
+        assert_eq!(parse_suggestion(response), None);
+    }
+    assert_eq!(
+        parse_suggestion(&json!({"suffix": "长".repeat(121)}).to_string()),
+        None
+    );
+}
