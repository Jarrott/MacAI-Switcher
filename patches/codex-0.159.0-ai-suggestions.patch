+    assert!(old.cancellation.is_cancelled());
+    tokio::task::yield_now().await;
+    tokio::time::advance(Duration::from_millis(1199)).await;
+    assert!(rx.try_recv().is_err());
+    tokio::time::advance(Duration::from_millis(2)).await;
+    tokio::task::yield_now().await;
+    let AppEvent::PromptSuggestion(SuggestionEvent::Request(first)) = rx.try_recv().unwrap() else {
+        panic!("completion request");
+    };
+    assert_eq!(first.prefix, "Improve this");
+    composer.insert_str(" function");
+    composer.sync_prompt_suggestion(true);
+    tokio::task::yield_now().await;
+    tokio::time::advance(Duration::from_secs(2)).await;
+    tokio::task::yield_now().await;
+    assert!(rx.try_recv().is_err());
+    tokio::time::advance(Duration::from_secs(4)).await;
+    tokio::task::yield_now().await;
+    let AppEvent::PromptSuggestion(SuggestionEvent::Request(second)) = rx.try_recv().unwrap()
+    else {
+        panic!("completion request");
+    };
+    assert_eq!(second.prefix, "Improve this function");
+    drop(composer);
+    assert!(second.cancellation.is_cancelled());
+}
