+//! Exercise the completion protocol against an isolated app-server, without credentials.
+use super::*;
+use crate::temporary_structured_request::*;
+use codex_app_server_client::AppServerEvent;
+use codex_app_server_protocol::ThreadSource;
+use futures::SinkExt;
+use futures::StreamExt;
+use pretty_assertions::assert_eq;
+use tokio::net::TcpListener;
+use tokio::sync::mpsc;
+use tokio_tungstenite::tungstenite::Message;
+
+#[tokio::test]
+async fn completion_turn_is_ephemeral_tool_free_and_detached() -> color_eyre::Result<()> {
+    let listener = TcpListener::bind("127.0.0.1:0").await?;
+    let address = listener.local_addr()?;
+    let thread_id = Uuid::new_v4().to_string();
+    let server_id = thread_id.clone();
+    let server = tokio::spawn(async move {
+        let (stream, _) = listener.accept().await?;
+        let mut socket = tokio_tungstenite::accept_async(stream).await?;
+        let mut methods = Vec::new();
+        while let Some(frame) = socket.next().await {
+            let frame = frame?;
+            if frame.is_close() {
+                break;
+            }
+            let request: Value = serde_json::from_str(frame.to_text()?)?;
+            let method = request["method"].as_str().unwrap();
+            if method == "initialized" {
+                continue;
+            }
+            let result = match method {
+                "initialize" => json!({"userAgent":"suggestion-test","codexHome":"/test/.codex"}),
+                "config/read" => {
+                    json!({"config":{"mcp_servers":{"test":{"enabled":true}}},"origins":{}})
+                }
+                "thread/start" => {
+                    let params = &request["params"];
+                    assert_eq!(params["ephemeral"], true);
+                    assert_eq!(params["sandbox"], "read-only");
+                    assert_eq!(params["config"]["features.shell_tool"], false);
+                    assert_eq!(params["config"]["features.multi_agent"], false);
+                    assert_eq!(params["config"]["mcp_servers"]["test"]["enabled"], false);
+                    json!({
+                        "thread":{"id":server_id,"sessionId":server_id,"preview":"","ephemeral":true,
+                            "modelProvider":"openai","createdAt":0,"updatedAt":0,"status":{"type":"idle"},
+                            "cwd":"/test","cliVersion":"0.159.0","source":"cli","turns":[]},
+                        "model":"test-model","modelProvider":"openai","cwd":"/test",
+                        "approvalPolicy":"never","approvalsReviewer":"user",
+                        "sandbox":{"type":"readOnly","networkAccess":false}
+                    })
+                }
+                "turn/start" => {
+                    assert_eq!(request["params"]["threadId"], server_id);
+                    assert_eq!(request["params"]["outputSchema"], suggestion_schema());
+                    assert_eq!(
+                        request["params"]["input"][0]["text"],
+                        suggestion_prompt("帮我整理")
+                    );
+                    json!({"turn":{"id":"turn-1","items":[],"status":"inProgress"}})
+                }
+                "thread/unsubscribe" => json!({"status":"unsubscribed"}),
+                other => panic!("unexpected method {other}"),
+            };
+            methods.push(method.to_owned());
+            socket
+                .send(Message::Text(
+                    json!({"id":request["id"],"result":result})
+                        .to_string()
+                        .into(),
+                ))
+                .await?;
+            if method == "turn/start" {
+                for notification in [
+                    json!({"method":"item/completed","params":{"threadId":server_id,"turnId":"turn-1","completedAtMs":0,
+                        "item":{"type":"agentMessage","id":"message-1","text":"{\"suffix\":\"这段代码并补充注释\"}"}}}),
+                    json!({"method":"turn/completed","params":{"threadId":server_id,
+                        "turn":{"id":"turn-1","items":[],"status":"completed"}}}),
+                ] {
+                    socket
+                        .send(Message::Text(notification.to_string().into()))
+                        .await?;
+                }
+            }
+        }
+        assert_eq!(
+            methods,
+            [
+                "initialize",
+                "config/read",
+                "thread/start",
+                "turn/start",
+                "thread/unsubscribe"
+            ]
+        );
+        Ok::<_, color_eyre::eyre::Report>(())
+    });
+    let mut client = crate::connect_remote_app_server(crate::RemoteAppServerEndpoint::WebSocket {
+        websocket_url: format!("ws://{address}"),
+        auth_token: None,
+    })
+    .await?;
+    let handle = client.request_handle();
+    let started = start_temporary_thread(
+        &handle,
+        TemporaryStructuredThreadOptions {
+            thread_source: ThreadSource::Feature("prompt_suggestion".to_owned()),
+            model: "test-model".to_owned(),
+            model_provider: "openai".to_owned(),
+            cwd: "/test".to_owned(),
+            active_permission_profile: None,
+            mcp_server_names: Vec::new(),
+        },
+    )
+    .await?;
+    assert_eq!(started.thread.id, thread_id);
+    let (tx, rx) = mpsc::unbounded_channel();
+    let task = run_temporary_structured_turn(
+        handle,
+        thread_id,
+        suggestion_prompt("帮我整理"),
+        suggestion_schema(),
+        None,
+        rx,
+        CancellationToken::new(),
+    );
+    tokio::pin!(task);
+    let response = loop {
+        tokio::select! {
+            result = &mut task => break result?,
+            event = client.next_event() => {
+                match event {
+                    Some(AppServerEvent::ServerNotification(notification)) => { tx.send(*notification)?; }
+                    Some(_) => {}
+                    None => panic!("server closed before completion"),
+                }
+            }
+        }
+    };
+    assert_eq!(
+        parse_suggestion(&response),
+        Some("这段代码并补充注释".to_owned())
+    );
+    client.shutdown().await?;
+    server.await??;
+    Ok(())
+}
