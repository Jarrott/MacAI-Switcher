+//! Keep AI suggestions in the main composer and out of approval or question inputs.
+use super::BottomPane;
+use crate::prompt_suggestion::SuggestionRequest;
+
+impl BottomPane {
+    /// Propagates window focus to the automatic completion scheduler.
+    pub(crate) fn set_prompt_suggestion_focus(&mut self, focused: bool) {
+        self.composer.set_prompt_suggestion_focus(focused);
+    }
+
+    /// Cancels completion when focus or the backend connection is lost.
+    pub(crate) fn cancel_prompt_suggestion(&mut self) {
+        self.composer.sync_prompt_suggestion(false);
+    }
+
+    /// Synchronizes completion only while the main input is visible and idle.
+    pub(crate) fn sync_prompt_suggestion(&mut self) {
+        let available =
+            !self.has_active_modal() && !self.is_task_running() && !self.shortcut_overlay_visible();
+        self.composer.sync_prompt_suggestion(available);
+    }
+
+    /// Checks revision ownership and modal/task state before accepting an asynchronous result.
+    pub(crate) fn prompt_suggestion_is_current(&self, request: &SuggestionRequest) -> bool {
+        !self.has_active_modal()
+            && !self.is_task_running()
+            && !self.shortcut_overlay_visible()
+            && self.composer.prompt_suggestion_is_current(request)
+    }
+
+    /// Routes matching results to the editor and schedules repainting of the ghost text.
+    pub(crate) fn apply_prompt_suggestion(
+        &mut self,
+        request: &SuggestionRequest,
+        suffix: Option<String>,
+    ) {
+        if self.prompt_suggestion_is_current(request) {
+            self.composer.apply_prompt_suggestion(request, suffix);
+            self.request_redraw();
+        }
+    }
+}
