+//! AI completion uses the existing isolated structured-turn transport, never the visible turn.
+
+use super::App;
+use crate::app_event::AppEvent;
+use crate::app_server_session::AppServerSession;
+use crate::prompt_suggestion::SuggestionEvent;
+use crate::prompt_suggestion::parse_suggestion;
+use crate::prompt_suggestion::suggestion_prompt;
+use crate::prompt_suggestion::suggestion_schema;
+use crate::temporary_structured_request::TemporaryStructuredThreadOptions;
+use crate::temporary_structured_request::run_temporary_structured_turn;
+use crate::temporary_structured_request::start_temporary_thread;
+use crate::temporary_structured_request::unsubscribe_temporary_thread;
+use codex_app_server_protocol::ThreadSource;
+use codex_protocol::ThreadId;
+use codex_protocol::openai_models::ReasoningEffort;
+use tokio::sync::mpsc;
+
+impl App {
+    /// Routes one draft revision through a tools-disabled ephemeral model request.
+    /// Stale revisions are cancelled and detached; only the matching editor receives a suffix.
+    pub(super) fn handle_prompt_suggestion_event(
+        &mut self,
+        app_server: &AppServerSession,
+        event: SuggestionEvent,
+    ) {
+        let request_handle = app_server.request_handle();
+        let sender = self.app_event_tx.clone();
+        match event {
+            SuggestionEvent::Request(request) => {
+                if self.overlay.is_some()
+                    || self.reconnect.offline
+                    || !self.chat_widget.prompt_suggestion_is_current(&request)
+                {
+                    request.cancellation.cancel();
+                    return;
+                }
+                let config = self.chat_widget.config_ref();
+                let fast_model = (config.model_provider_id == "openai"
+                    && self.chat_widget.has_chatgpt_account())
+                .then(|| self.chat_widget.model_catalog().try_list_models().ok())
+                .flatten()
+                .and_then(|models| {
+                    ["gpt-6-luna", "gpt-5.6-luna"]
+                        .into_iter()
+                        .find(|candidate| models.iter().any(|model| model.model == *candidate))
+                });
+                let effort = fast_model.map(|_| ReasoningEffort::Low);
+                let options = TemporaryStructuredThreadOptions {
+                    thread_source: ThreadSource::Feature("prompt_suggestion".to_owned()),
+                    model: fast_model
+                        .unwrap_or(self.chat_widget.current_model())
+                        .to_owned(),
+                    model_provider: config.model_provider_id.clone(),
+                    cwd: config.cwd.display().to_string(),
+                    active_permission_profile: config
+                        .permissions
+                        .active_permission_profile()
+                        .map(|p| p.id),
+                    mcp_server_names: config.mcp_servers.get().keys().cloned().collect(),
+                };
+                tokio::spawn(async move {
+                    let result = start_temporary_thread(&request_handle, options)
+                        .await
+                        .map(|thread| thread.thread.id)
+                        .map_err(|error| error.to_string());
+                    sender.send(AppEvent::PromptSuggestion(SuggestionEvent::Started {
+                        request,
+                        effort,
+                        result,
+                    }));
+                });
+            }
+            SuggestionEvent::Started {
+                request,
+                effort,
+                result,
+            } => {
+                let Ok(thread_id_text) = result else {
+                    self.chat_widget.apply_prompt_suggestion(&request, None);
+                    return;
+                };
+                let thread_id = match ThreadId::from_string(&thread_id_text) {
+                    Ok(thread_id)
+                        if self.overlay.is_none()
+                            && !self.reconnect.offline
+                            && self.chat_widget.prompt_suggestion_is_current(&request) =>
+                    {
+                        thread_id
+                    }
+                    Ok(_) | Err(_) => {
+                        request.cancellation.cancel();
+                        tokio::spawn(async move {
+                            unsubscribe_temporary_thread(&request_handle, thread_id_text).await;
+                        });
+                        return;
+                    }
+                };
+                let (tx, rx) = mpsc::unbounded_channel();
+                self.temporary_structured_requests.insert(thread_id, tx);
+                tokio::spawn(async move {
+                    let work = run_temporary_structured_turn(
+                        request_handle,
+                        thread_id_text,
+                        suggestion_prompt(&request.prefix),
+                        suggestion_schema(),
+                        effort,
+                        rx,
+                        request.cancellation.clone(),
+                    );
+                    tokio::pin!(work);
+                    // Cancel before the shared helper deadline so it interrupts the model turn,
+                    // then let that helper finish its bounded cleanup instead of dropping it.
+                    let result = tokio::select! {
+                        result = &mut work => result,
+                        _ = tokio::time::sleep(std::time::Duration::from_secs(15)) => {
+                            request.cancellation.cancel();
+                            work.await
+                        }
+                    }
+                    .map_err(|error| error.to_string());
+                    sender.send(AppEvent::PromptSuggestion(SuggestionEvent::Finished {
+                        request,
+                        temporary_thread_id: thread_id,
+                        result,
+                    }));
+                });
+            }
+            SuggestionEvent::Finished {
+                request,
+                temporary_thread_id,
+                result,
+            } => {
+                self.temporary_structured_requests
+                    .remove(&temporary_thread_id);
+                self.chat_widget.apply_prompt_suggestion(
+                    &request,
+                    result.ok().and_then(|response| parse_suggestion(&response)),
+                );
+            }
+        }
+    }
+}
