+    composer.set_text_content("Improve".to_owned(), Vec::new(), Vec::new());
+    composer.move_cursor_to_end();
+    composer.sync_prompt_suggestion(true);
+    let old = composer.suggestion.request.clone().unwrap();
+    tokio::task::yield_now().await;
+    tokio::time::advance(Duration::from_millis(600)).await;
+    composer.insert_str(" this");
