+//! Subtle composer-only fills and readable placeholder text; transcript colors stay independent.
+
+use crate::color::blend;
+use crate::color::is_light;
+use crate::style::readable_color_on;
+use crate::style::secondary_text_style;
+use crate::terminal_palette::best_color;
+use crate::terminal_palette::default_bg;
+use ratatui::style::Color;
+use ratatui::style::Style;
+
+pub(super) struct ComposerAppearance {
+    pub(super) surface: Style,
+    pub(super) placeholder: Style,
+}
+
+/// Resolves a quiet input fill and readable hint against the detected terminal palette.
+/// Unknown backgrounds retain the original unpainted surface and dim hint; known
+/// backgrounds use the existing color-depth and contrast helpers. This only returns
+/// rendering styles and never changes the terminal palette, input, or configuration.
+pub(super) fn composer_appearance() -> ComposerAppearance {
+    let Some(background) = default_bg() else {
+        return ComposerAppearance {
+            surface: Style::default(),
+            placeholder: Style::default().dim(),
+        };
+    };
+    let (foreground, alpha) = if is_light(background) {
+        ((0, 0, 0), 0.03)
+    } else {
+        ((255, 255, 255), 0.09)
+    };
+    let surface = Style::default().bg(best_color(blend(foreground, background, alpha)));
+    let placeholder = secondary_text_style();
+    ComposerAppearance {
+        surface,
+        placeholder: placeholder.fg(readable_color_on(
+            placeholder.fg.unwrap_or(Color::Reset),
+            surface.bg,
+        )),
+    }
+}
