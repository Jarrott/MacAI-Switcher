+//! Input color and wrapping snapshots on light and dark terminal palettes.
+
+use super::tests::new_test_composer;
+use crate::render::renderable::Renderable;
+use crate::terminal_palette::with_test_default_colors;
+use crate::terminal_probe::DefaultColors;
+use ratatui::buffer::Buffer;
+use ratatui::layout::Rect;
+
+#[test]
+fn refined_input_palette_and_wrapping_snapshots() {
+    for (theme, colors) in [
+        (
+            "dark",
+            DefaultColors {
+                fg: (232, 234, 237),
+                bg: (24, 26, 31),
+            },
+        ),
+        (
+            "light",
+            DefaultColors {
+                fg: (55, 57, 59),
+                bg: (250, 250, 250),
+            },
+        ),
+    ] {
+        with_test_default_colors(colors, || {
+            for (state, width, text) in [
+                ("empty", 48, ""),
+                ("chinese", 48, "整理一下这段代码，让命名更清楚。"),
+                ("wrapped", 16, "Keep the input calm and readable."),
+            ] {
+                let (mut composer, _rx) = new_test_composer();
+                composer.set_text_content(text.to_owned(), Vec::new(), Vec::new());
+                composer.move_cursor_to_end();
+                let area = Rect::new(0, 0, width, composer.desired_height(width));
+                let mut buffer = Buffer::empty(area);
+                composer.render(area, &mut buffer);
+                let (x, y) = composer.cursor_pos(area).expect("enabled input cursor");
+                assert!(x < width - 2 && y < area.height);
+                insta::assert_snapshot!(
+                    format!("refined_input_{theme}_{state}"),
+                    format!("{buffer:?}")
+                );
+            }
+        });
+    }
+}
