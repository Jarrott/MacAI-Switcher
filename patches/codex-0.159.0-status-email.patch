+//! Account notifications hydrate display identity from the connected server.
+
+use super::*;
+use crate::app_server_session::ThreadParamsMode;
+use crate::status::StatusAccountDisplay;
+use codex_app_server_client::AppServerEvent;
+use codex_app_server_protocol::AccountUpdatedNotification;
+use codex_app_server_protocol::AuthMode;
+use codex_protocol::account::PlanType;
+use futures::SinkExt;
+use futures::StreamExt;
+use pretty_assertions::assert_eq;
+use serde_json::Value;
+use serde_json::json;
+use tokio::net::TcpListener;
+use tokio_tungstenite::tungstenite::Message;
+
+#[tokio::test]
+async fn account_notification_reads_email_from_server_and_clears_stale_identity() -> Result<()> {
+    let mut app = make_test_app().await;
+    let listener = TcpListener::bind("127.0.0.1:0").await?;
+    let address = listener.local_addr()?;
+    // Mock the app-server boundary itself: no credential files or provider network.
+    let server = tokio::spawn(async move {
+        let (stream, _) = listener.accept().await?;
+        let mut socket = tokio_tungstenite::accept_async(stream).await?;
+        let mut account_reads = 0;
+        while let Some(frame) = socket.next().await {
+            let frame = frame?;
+            if frame.is_close() {
+                break;
+            }
+            let request: Value = serde_json::from_str(frame.to_text()?)?;
+            let id = &request["id"];
+            let response = match request["method"].as_str() {
+                Some("initialize") => json!({"id": id, "result": {
+                    "userAgent": "email-test", "codexHome": "/server/.codex"
+                }}),
+                Some("initialized") => continue,
+                Some("account/read") => {
+                    let params: codex_app_server_protocol::GetAccountParams =
+                        serde_json::from_value(request["params"].clone())?;
+                    assert!(!params.refresh_token);
+                    account_reads += 1;
+                    match account_reads {
+                        1 | 2 | 4 => {
+                            let email = match account_reads {
+                                1 => Some("first@example.test"),
+                                2 => Some("second@example.test"),
+                                _ => None,
+                            };
+                            json!({"id": id, "result": {
+                                "account": {"type": "chatgpt", "email": email, "planType": "pro"},
+                                "requiresOpenaiAuth": true
+                            }})
+                        }
+                        3 => json!({"id": id, "error": {"code": -32603, "message": "unavailable"}}),
+                        _ => panic!("unexpected account read"),
+                    }
+                }
+                method => panic!("unexpected method: {method:?}"),
+            };
+            socket
+                .send(Message::Text(response.to_string().into()))
+                .await?;
+        }
+        assert_eq!(account_reads, 4);
+        Ok::<_, color_eyre::eyre::Report>(())
+    });
+    let client = crate::connect_remote_app_server(crate::RemoteAppServerEndpoint::WebSocket {
+        websocket_url: format!("ws://{address}"),
+        auth_token: None,
+    })
+    .await?;
+    let app_server = AppServerSession::new(client, ThreadParamsMode::Remote);
+    for email in [
+        Some("first@example.test"),
+        Some("second@example.test"),
+        None,
+        None,
+    ] {
+        app.handle_app_server_event(
+            &app_server,
+            AppServerEvent::ServerNotification(Box::new(ServerNotification::AccountUpdated(
+                AccountUpdatedNotification {
+                    auth_mode: Some(AuthMode::Chatgpt),
+                    plan_type: Some(PlanType::Pro),
+                },
+            ))),
+        )
+        .await;
+        assert_eq!(
+            app.chat_widget.status_account_display(),
+            Some(&StatusAccountDisplay::ChatGpt {
+                email: email.map(str::to_owned),
+                plan: Some("Pro (More)".to_owned())
+            })
+        );
+    }
+    app.handle_app_server_event(
+        &app_server,
+        AppServerEvent::ServerNotification(Box::new(ServerNotification::AccountUpdated(
+            AccountUpdatedNotification {
+                auth_mode: None,
+                plan_type: None,
+            },
+        ))),
+    )
+    .await;
+    assert_eq!(app.chat_widget.status_account_display(), None);
+    app_server.shutdown().await?;
+    server.await??;
+    Ok(())
+}
