+/// Exercise clipping at a nonzero origin so border/prompt arithmetic cannot escape the buffer.
+#[test]
+fn rounded_input_handles_clipped_rectangles() {
+    for width in 0..12 {
+        for height in 0..5 {
+            let (mut composer, _) = new_test_composer();
+            composer.set_text_content("输入边界".to_owned(), Vec::new(), Vec::new());
+            composer.move_cursor_to_end();
+            let area = Rect::new(3, 2, width, height);
+            let mut buffer = Buffer::empty(area);
+            composer.render(area, &mut buffer);
+            if let Some((x, y)) = composer.cursor_pos(area) {
+                assert!(x >= area.x && x < area.right() && y >= area.y && y < area.bottom());
+            }
+        }
+    }
+}
