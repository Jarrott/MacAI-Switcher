+/// Draws a rounded outline after decorative effects so they cannot erase its edges.
+/// Only the existing padding is occupied; narrow/clipped rectangles safely omit the
+/// outline. The caller resolves focus/disabled styling; no input state is modified.
+pub(super) fn render_frame(area: Rect, border_style: Style, buf: &mut Buffer) {
+    if area.width >= 3 && area.height >= 3 {
+        Block::bordered()
+            .border_type(BorderType::Rounded)
+            .border_style(border_style)
+            .render(area, buf);
+    }
